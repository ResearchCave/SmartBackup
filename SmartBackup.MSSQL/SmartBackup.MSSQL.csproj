<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

 

    
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.19.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
  </ItemGroup>







	<ItemGroup>
		<NativeKerberosDlls Include="$(PublishDir)krb*.dll" />
		<NativeKerberosDlls Include="$(PublishDir)k5*.dll" />
		<NativeKerberosDlls Include="$(PublishDir)gssapi*.dll" />
	</ItemGroup>

	<Target Name="MoveNativeKerberosDlls" AfterTargets="Publish">
		<MakeDir Directories="$(PublishDir)runtimes\win-x64\native" />

		<Move SourceFiles="@(NativeKerberosDlls)" DestinationFolder="$(PublishDir)runtimes\win-x64\native" />
	</Target>
	
	
	
	
	
 
